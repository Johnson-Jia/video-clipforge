# 视频生成工作目录（项目文件、渲染产物、音视频素材）
workspace/

# Node
node_modules/
package-lock.json

# 系统文件
.DS_Store
Thumbs.db

# 环境变量
.env
.env.local

# 个人定时任务配置（通过 /clipforge-category-setup 生成）
.claude/commands/github-daily-trending.md
.claude/commands/github-weekly-trending.md
.claude/commands/github-weekly-zhihu.md
.claude/commands/*-daily-*.md
.claude/commands/*-weekly-*.md

.idea/

.idea/agents/
.claude/skills/
skills-lock.json
.claude/scheduled_tasks.json
.claude/scheduled_tasks.lock

.agents/

# Python
__pycache__/
*.pyc

# 引擎执行轨迹
.claude/commands/clipforge/traces/

# 引擎运行时 Delta（规则增量变更产物）
.claude/commands/clipforge/deltas/
