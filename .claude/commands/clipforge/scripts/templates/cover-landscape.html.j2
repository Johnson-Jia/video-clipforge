<!-- generated by generate_cover.py -->
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap');
* { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  --accent-warm: {{ colors.accent_warm }};
  --accent-warm-soft: {{ colors.accent_warm_soft }};
  --accent-warm-rgb: {{ colors.accent_warm_rgb }};
  --accent-cool: {{ colors.accent_cool }};
  --accent-cool-soft: {{ colors.accent_cool_soft }};
  --accent-cool-rgb: {{ colors.accent_cool_rgb }};
  --bg-dark: {{ colors.bg_dark }};
  --bg-mid: {{ colors.bg_mid }};
  --bg-bottom: {{ colors.bg_bottom }};
  --text-white: {{ colors.text_white }};
  --text-muted: {{ colors.text_muted }};
  --card-bg: {{ colors.card_bg }};
  --glow-warm-opacity: {{ colors.glow_warm_opacity }};
  --glow-cool-opacity: {{ colors.glow_cool_opacity }};
}

body { background: #050510; overflow: hidden; font-family: 'Inter', 'PingFang SC', 'Microsoft YaHei', sans-serif; }

.cover {
  position: relative; width: 3840px; height: 2160px;
  background: linear-gradient(180deg, var(--bg-dark) 0%, var(--bg-mid) 40%, var(--bg-bottom) 100%);
  overflow: hidden;
}

.glow-warm {
  position: absolute; width: 1400px; height: 1400px; border-radius: 50%;
  background: radial-gradient(circle, rgba(var(--accent-warm-rgb), var(--glow-warm-opacity)), transparent 70%);
  filter: blur(200px); top: -200px; left: -400px; pointer-events: none;
}
.glow-cool {
  position: absolute; width: 1200px; height: 1200px; border-radius: 50%;
  background: radial-gradient(circle, rgba(var(--accent-cool-rgb), var(--glow-cool-opacity)), transparent 70%);
  filter: blur(200px); bottom: -200px; right: -400px; pointer-events: none;
}

/* 4:3 安全区（2880x2160 水平居中）—— 修正：原 1620 是 3:4 竖向比例，横屏应为 4:3 横向 */
.safe-zone {
  position: relative; z-index: 5;
  width: 2880px; height: 100%;
  margin: 0 auto;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
}

/* 第1层：中文日期 */
.date { position: relative; font-size: 56px; font-weight: 800;
  color: var(--accent-warm); letter-spacing: 6px; margin-bottom: 24px; }

/* 第2层：场景标签 */
.scene-label { position: relative; font-size: 44px; font-weight: 600;
  color: var(--accent-cool); letter-spacing: 4px; margin-bottom: 48px; }

/* 第3层：胶囊徽章 */
.badge { position: relative; display: inline-block;
  background: linear-gradient(135deg, rgba(var(--accent-warm-rgb), 0.15), rgba(var(--accent-warm-rgb), 0.25));
  border: 2px solid rgba(var(--accent-warm-rgb), 0.4); border-radius: 100px;
  padding: 20px 72px; font-size: 44px; font-weight: 700;
  color: var(--accent-warm-soft); letter-spacing: 6px; margin-bottom: 72px;
  box-shadow: 0 0 40px rgba(var(--accent-warm-rgb), 0.1);
}

/* 第4层：主标题（多色段） */
.main-title { position: relative; text-align: center; line-height: 1.2; margin-bottom: 40px; }
.main-title .white { font-size: 160px; font-weight: 900; color: var(--text-white); letter-spacing: -3px; }
.main-title .accent { font-size: 160px; font-weight: 900; color: var(--accent-warm); letter-spacing: -3px;
  text-shadow: 0 0 60px rgba(var(--accent-warm-rgb), 0.4), 0 0 120px rgba(var(--accent-warm-rgb), 0.15); }
.main-title .cool { font-size: 160px; font-weight: 900; color: var(--accent-cool); letter-spacing: -3px;
  text-shadow: 0 0 60px rgba(var(--accent-cool-rgb), 0.4), 0 0 120px rgba(var(--accent-cool-rgb), 0.15); }

/* 第5层：渐变分隔线 */
.divider { position: relative; width: 600px; height: 8px; border-radius: 4px;
  background: linear-gradient(90deg, var(--accent-warm), var(--accent-cool-soft)); margin-bottom: 48px; }

/* 第6层：数据说明 */
.data-subtitle { position: relative; font-size: 60px; font-weight: 600;
  color: var(--accent-cool); letter-spacing: 3px; margin-bottom: 60px; }

/* 第7层：数据卡片 */
.cards { position: relative; display: flex; gap: 48px; }
.card { background: var(--card-bg);
  border: 2px solid rgba(var(--accent-warm-rgb), 0.2); border-radius: 36px;
  padding: 40px 72px; text-align: center; min-width: 320px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.3);
}
.card .num { font-family: 'JetBrains Mono', monospace; font-size: 88px;
  font-weight: 700; color: var(--accent-warm-soft); line-height: 1; }
.card .label { font-size: 36px; color: var(--text-muted); margin-top: 16px; letter-spacing: 2px; }
</style>
</head>
<body>
<div data-composition-id="cover" data-width="3840" data-height="2160" data-start="0" data-duration="1">
<div class="clip" data-start="0" data-duration="1">
<div class="cover">
  <div class="glow-warm"></div>
  <div class="glow-cool"></div>

  <!-- 3:4 安全区：所有内容层限制在此 -->
  <div class="safe-zone">
    <!-- 第1层：中文日期 -->
    <div class="date">{{ date }}</div>

    <!-- 第2层：场景标签 -->
    <div class="scene-label">{{ scene_label }}</div>

    <!-- 第3层：胶囊徽章 -->
    <div class="badge">{{ badge }}</div>

    <!-- 第4层：主标题（title = 行数组，每行 = 段数组） -->
    <div class="main-title">
      {%- for line in title -%}
      {%- if not loop.first %}<br>{% endif -%}
      {%- for seg in line -%}
      <span class="{{ seg.style }}">{{ seg.text }}</span>
      {%- endfor -%}
      {%- endfor %}
    </div>

    <!-- 第5层：渐变分隔线 -->
    <div class="divider"></div>

    <!-- 第6层：数据说明 -->
    <div class="data-subtitle">{{ data_subtitle }}</div>

    <!-- 第7层：数据卡片 -->
    <div class="cards">
      {% for card in cards %}
      <div class="card">
        <div class="num">{{ card.num }}</div>
        <div class="label">{{ card.label }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>
</div>
</div>
<script>window.__hf = { duration: 1, seek: function(t) {} };window.__timelines = {};</script>
</body>
</html>
